#!/bin/sh
project_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
export PYTHONDONTWRITEBYTECODE=1
export PYTHONNOUSERSITE=1
unset PYTHONHOME PYTHONPATH
runtime="$project_dir/Agent Orbit.app/Contents/Resources/python/bin/python3"
if test -x "$runtime"; then exec "$runtime" "$project_dir/agent_orbit_cli.py" "$@"; fi
exec python3 "$project_dir/agent_orbit_cli.py" "$@"
